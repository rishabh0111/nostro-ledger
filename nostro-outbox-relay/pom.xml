<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nostro</groupId>
    <artifactId>nostro-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nostro-outbox-relay</artifactId>
  <name>Nostro :: Outbox Relay</name>
  <description>The single-writer deployable that drains the ledger's outbox into Kafka, in order.</description>

  <!--
    May depend on: the outbox contract, Kafka's client, JDBC. Must not: the ledger's JPA layer,
    the gRPC contract, the API service (docs/research/grpc-and-multi-module-layout.md section 3).
    It reads one table over one connection, and a persistence context would be all cost.
  -->
  <dependencies>
    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-outbox</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The ledger's migrations, run by the tests the way the migration container runs them. -->
    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-ledger-schema</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <!-- The rule above, as a build failure rather than a convention. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>the-relay-has-no-jpa-layer</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.nostro:nostro-persistence</exclude>
                    <exclude>io.nostro:nostro-api-service</exclude>
                    <exclude>org.hibernate.orm</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
