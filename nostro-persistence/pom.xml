<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nostro</groupId>
    <artifactId>nostro-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>nostro-persistence</artifactId>
  <name>Nostro :: Persistence</name>
  <description>Hibernate entities, the Tenant-context hook, and the Entry writer over the ledger database.</description>

  <!-- May depend on: domain, Hibernate, Flyway, Spring Data. Must not: gRPC, protobuf, Kafka. -->
  <dependencies>
    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-domain</artifactId>
    </dependency>
    <!-- The payload the Entry's transaction writes into the outbox. -->
    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-outbox</artifactId>
    </dependency>
    <!-- The migrations Flyway runs at startup and the mapping is validated against. -->
    <dependency>
      <groupId>io.nostro</groupId>
      <artifactId>nostro-ledger-schema</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <!-- Compile scope, not runtime: the writer switches on SQLSTATE and constraint names read off PSQLException. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The write path's own metrics: latency by contention, floor refusals, SQLSTATEs. The registry is the application's. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
